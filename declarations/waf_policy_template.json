    },
    "server-technologies": [
        {
            "serverTechnologyName": "PHP",
            "serverTechnologyReference": {
                "link": "https://www.php.net"
            }
        },
        {
            "serverTechnologyName": "Apache HTTP Server",
            "serverTechnologyReference": {
                "link": "https://httpd.apache.org"
            }
        },
        {
            "serverTechnologyName": "MySQL",
            "serverTechnologyReference": {
                "link": "https://www.mysql.com"
            }
        }
