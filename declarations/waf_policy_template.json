        },
        {
            "name": "Generic Detection Signatures (High/Low Accuracy)",
            "block": false,
            "alarm": true
        },
        {
            "name": "Command Execution Signatures (High/Low Accuracy)",
            "block": false,
            "alarm": true
        },
        {
            "name": "Path Traversal Signatures (High/Low Accuracy)",
            "block": false,
            "alarm": true
        }
