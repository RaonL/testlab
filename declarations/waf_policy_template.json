            {
                "name": "VIOLATION_XSS",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_HTTP_METHOD",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_FILE_TYPE",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_PARAMETER_VALUE",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_PARAMETER_NAME",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_URL",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_MANDATORY_PARAMETER",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_JSON_MALFORMED",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_COOKIE_MALFORMED",
                "block": false,
                "alarm": true
            },
            {
                "name": "VIOLATION_PARAMETER_DATA_TYPE",
